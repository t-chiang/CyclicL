<?xml version="1.0" encoding="ASCII"?>
<rmdl:RMDL_Project xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:rmdl="http://www.example.org/rmdl">
  <feature_model name="Adaptive Cruise Control">
    <featureEntity xsi:type="rmdl:Element" name="Steering Wheel" composes="//@feature_model.0/@featureEntity.1" optional="//@feature_model.0/@featureEntity.4">
      <testCase ID="1" description="Test tactility of buttons" requirements="//@feature_model.0/@featureEntity.0/@requirements.0"/>
      <testCase ID="2" requirements="//@feature_model.0/@featureEntity.0/@requirements.2"/>
      <testCase ID="3" requirements="//@feature_model.0/@featureEntity.0/@requirements.1"/>
      <testCase ID="8" requirements="//@feature_model.0/@featureEntity.0/@requirementcontainer.0"/>
      <testCase ID="9" requirements="//@feature_model.0/@featureEntity.0/@requirementcontainer.0 //@feature_model.0/@featureEntity.0/@requirements.1"/>
      <requirements xsi:type="rmdl:Qualitative" name="Button Quality" ID="1" description="Interface buttons shall have tactile feel to them" review="//@feature_model.0/@featureEntity.0/@review.0" testCase="//@feature_model.0/@featureEntity.0/@testCase.0" traceTo="//@feature_model.0/@featureEntity.0/@designElement.2" specification="&#xD;&#xA;Given{&#xD;&#xA;&#x9;Precond none:&quot;N/A&quot;&#xD;&#xA;}&#xD;&#xA;When{&#xD;&#xA;&#x9;Event ButtonPress: &quot;User presses a button.&quot;&#xD;&#xA;}&#xD;&#xA;Then{&#xD;&#xA;&#x9;Postcond Tactility: &quot;User should feel a bump that requires 45g of force to complete depression.&quot;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;"/>
      <requirements xsi:type="rmdl:Functional" name="Button Functions" ID="2" description="Buttons shall allow user to interact with infotainment system of vehicle" review="//@feature_model.0/@featureEntity.0/@review.2" testCase="//@feature_model.0/@featureEntity.0/@testCase.2 //@feature_model.0/@featureEntity.0/@testCase.4" traceTo="//@feature_model.0/@featureEntity.0/@designElement.1 //@feature_model.0/@featureEntity.0/@designElement.2"/>
      <requirements xsi:type="rmdl:Constraint" name="Button Latency" ID="5" description="Button shall be easily swappable in the event of fading or wear and tear" review="//@feature_model.0/@featureEntity.0/@review.0" testCase="//@feature_model.0/@featureEntity.0/@testCase.1" traceTo="//@feature_model.0/@featureEntity.0/@designElement.1 //@feature_model.0/@featureEntity.0/@designElement.2"/>
      <review reviewer="Reviewer1" requirements="//@feature_model.0/@featureEntity.0/@requirements.0 //@feature_model.0/@featureEntity.0/@requirements.2"/>
      <review reviewer="Reviewer2" requirements="//@feature_model.0/@featureEntity.0/@requirementcontainer.0"/>
      <review reviewer="Reviewer3" requirements="//@feature_model.0/@featureEntity.0/@requirements.1 //@feature_model.0/@featureEntity.0/@requirementcontainer.0"/>
      <designElement name="Wheel Heating" traceFrom="//@feature_model.0/@featureEntity.0/@requirementcontainer.0" implementationOf="//@feature_model.0/@featureEntity.2"/>
      <designElement name="Infotainment Control" isSoftware="true" traceFrom="//@feature_model.0/@featureEntity.0/@requirements.1 //@feature_model.0/@featureEntity.0/@requirements.2"/>
      <designElement name="Infotainment Interface" isHardware="true" traceFrom="//@feature_model.0/@featureEntity.0/@requirements.0 //@feature_model.0/@featureEntity.0/@requirements.1 //@feature_model.0/@featureEntity.0/@requirements.2"/>
      <requirementcontainer name="ReqDecisionBlock" ID="13" review="//@feature_model.0/@featureEntity.0/@review.1 //@feature_model.0/@featureEntity.0/@review.2" testCase="//@feature_model.0/@featureEntity.0/@testCase.3 //@feature_model.0/@featureEntity.0/@testCase.4" traceTo="//@feature_model.0/@featureEntity.0/@designElement.0">
        <ownedRequirements xsi:type="rmdl:Safety" name="Wheel Heating Temperature" ID="4" description="Wheel heating shall remain within acceptable temperature for human skin"/>
        <ownedRequirements xsi:type="rmdl:Functional" name="Wheel Heating Off" ID="3" description="User shall be able to turn wheel heating on" specification="Given{&#xD;&#xA;&#x9;Precond FeatureExists: &quot;Steering wheel has heating feature.&quot;&#xD;&#xA;&#x9;Precond CarIsOn: &quot;Vehicle is on.&quot;&#xD;&#xA;}&#xD;&#xA;When{&#xD;&#xA;&#x9;Event UserTurnsOnHeating: &quot;User interacts with heating interface to turn on/off wheel heating.&quot;&#xD;&#xA;}&#xD;&#xA;Then{&#xD;&#xA;&#x9;Postcond StateChange: &quot;Wheel heating boolean changes state to on or off depending on current state.&quot;&#xD;&#xA;}"/>
        <ownedRequirements xsi:type="rmdl:Functional" name="Wheel Heating Off" ID="10" description="User shall be able to turn wheel heating off"/>
      </requirementcontainer>
    </featureEntity>
    <featureEntity xsi:type="rmdl:Root" name="Adaptive Cruise Control" mandatory="//@feature_model.0/@featureEntity.0 //@feature_model.0/@featureEntity.2 //@feature_model.0/@featureEntity.3 //@feature_model.0/@featureEntity.5"/>
    <featureEntity xsi:type="rmdl:Element" name="On/Off trigger" composes="//@feature_model.0/@featureEntity.1"/>
    <featureEntity xsi:type="rmdl:Element" name="Manual Override" composes="//@feature_model.0/@featureEntity.1"/>
    <featureEntity xsi:type="rmdl:Element" name="Wheel Heating" optionOf="//@feature_model.0/@featureEntity.0">
      <requirements xsi:type="rmdl:Functional" name="FunctionalReq1" ID="17"/>
    </featureEntity>
    <featureEntity xsi:type="rmdl:Element" name="Automatic Braking" composes="//@feature_model.0/@featureEntity.1" mandatory="//@feature_model.0/@featureEntity.8" alternative="//@feature_model.0/@featureEntity.6 //@feature_model.0/@featureEntity.7"/>
    <featureEntity xsi:type="rmdl:Element" name="Lidar and Sonar Sensors" alternativeOf="//@feature_model.0/@featureEntity.5">
      <testCase ID="6" hasPassed="true" requirements="//@feature_model.0/@featureEntity.6/@requirements.0"/>
      <testCase ID="7" requirements="//@feature_model.0/@featureEntity.6/@requirements.1"/>
      <testCase ID="8" requirements="//@feature_model.0/@featureEntity.6/@requirements.2"/>
      <testCase ID="9" hasPassed="true" requirements="//@feature_model.0/@featureEntity.6/@requirements.3"/>
      <requirements xsi:type="rmdl:Functional" name="FunctionalReq1" ID="6" review="//@feature_model.0/@featureEntity.6/@review.0" testCase="//@feature_model.0/@featureEntity.6/@testCase.0" traceTo="//@feature_model.0/@featureEntity.6/@designElement.1"/>
      <requirements xsi:type="rmdl:Qualitative" name="Qualitative1" ID="7" review="//@feature_model.0/@featureEntity.6/@review.0" testCase="//@feature_model.0/@featureEntity.6/@testCase.1" traceTo="//@feature_model.0/@featureEntity.6/@designElement.1 //@feature_model.0/@featureEntity.6/@designElement.2"/>
      <requirements xsi:type="rmdl:Constraint" name="Constraint1" ID="8" review="//@feature_model.0/@featureEntity.6/@review.0" testCase="//@feature_model.0/@featureEntity.6/@testCase.2" traceTo="//@feature_model.0/@featureEntity.6/@designElement.2 //@feature_model.0/@featureEntity.6/@designElement.0"/>
      <requirements xsi:type="rmdl:Safety" name="Safety1" ID="9" review="//@feature_model.0/@featureEntity.6/@review.1" testCase="//@feature_model.0/@featureEntity.6/@testCase.3" traceTo="//@feature_model.0/@featureEntity.6/@designElement.0"/>
      <review reviewer="Reviewer1" requirements="//@feature_model.0/@featureEntity.6/@requirements.1 //@feature_model.0/@featureEntity.6/@requirements.2 //@feature_model.0/@featureEntity.6/@requirements.0"/>
      <review reviewer="Reviewer2" requirements="//@feature_model.0/@featureEntity.6/@requirements.3" isApproved="true"/>
      <designElement name="designElement1" traceFrom="//@feature_model.0/@featureEntity.6/@requirements.2 //@feature_model.0/@featureEntity.6/@requirements.3"/>
      <designElement name="designElement2" traceFrom="//@feature_model.0/@featureEntity.6/@requirements.0 //@feature_model.0/@featureEntity.6/@requirements.1"/>
      <designElement name="designElement3" traceFrom="//@feature_model.0/@featureEntity.6/@requirements.1 //@feature_model.0/@featureEntity.6/@requirements.2"/>
    </featureEntity>
    <featureEntity xsi:type="rmdl:Element" name="Radar and Camera Sensors" alternativeOf="//@feature_model.0/@featureEntity.5"/>
    <featureEntity xsi:type="rmdl:Element" name="Feature8" composes="//@feature_model.0/@featureEntity.5"/>
    <product_variant name="Adaptive Cruise Control Variant1 no lidar"/>
    <product_variant name="Adaptive Cruise Control Variant2 no heating"/>
  </feature_model>
  <requirement_canvas/>
</rmdl:RMDL_Project>
