<?xml version="1.0" encoding="UTF-8"?>
<rmdl:RMDL_Project xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:rmdl="http://www.example.org/rmdl">
  <feature_model name="Example">
    <featureEntity xsi:type="rmdl:Root" name="Example" mandatory="//@feature_model.0/@featureEntity.1 //@feature_model.0/@featureEntity.2"/>
    <featureEntity xsi:type="rmdl:Element" name="Feature1" composes="//@feature_model.0/@featureEntity.0" optional="//@feature_model.0/@featureEntity.3 //@feature_model.0/@featureEntity.4">
      <testCase ID="1" requirements="//@feature_model.0/@featureEntity.1/@requirements.0"/>
      <testCase ID="2" requirements="//@feature_model.0/@featureEntity.1/@requirements.1"/>
      <requirements xsi:type="rmdl:Functional" name="FunctionalReq1" ID="1" review="//@feature_model.0/@featureEntity.1/@review.0" testCase="//@feature_model.0/@featureEntity.1/@testCase.0" traceTo="//@feature_model.0/@featureEntity.1/@designElement.0"/>
      <requirements xsi:type="rmdl:Functional" name="FunctionalReq2" ID="2" review="//@feature_model.0/@featureEntity.1/@review.1" testCase="//@feature_model.0/@featureEntity.1/@testCase.1"/>
      <requirements xsi:type="rmdl:Functional" name="FunctionalReq3" ID="3"/>
      <review reviewer="Reviewer1" requirements="//@feature_model.0/@featureEntity.1/@requirements.0"/>
      <review reviewer="Reviewer2" requirements="//@feature_model.0/@featureEntity.1/@requirements.1"/>
      <designElement name="designElement1" traceFrom="//@feature_model.0/@featureEntity.1/@requirements.0" implementationOf="//@feature_model.0/@featureEntity.3"/>
    </featureEntity>
    <featureEntity xsi:type="rmdl:Element" name="Feature2" composes="//@feature_model.0/@featureEntity.0" alternative="//@feature_model.0/@featureEntity.6 //@feature_model.0/@featureEntity.5 //@feature_model.0/@featureEntity.7"/>
    <featureEntity xsi:type="rmdl:Element" name="Feature3" optionOf="//@feature_model.0/@featureEntity.1"/>
    <featureEntity xsi:type="rmdl:Element" name="Feature4" optionOf="//@feature_model.0/@featureEntity.1"/>
    <featureEntity xsi:type="rmdl:Element" name="Feature5" alternativeOf="//@feature_model.0/@featureEntity.2"/>
    <featureEntity xsi:type="rmdl:Element" name="Feature6" alternativeOf="//@feature_model.0/@featureEntity.2"/>
    <featureEntity xsi:type="rmdl:Element" name="Feature7" alternativeOf="//@feature_model.0/@featureEntity.2"/>
    <product_variant name="Example">
      <featureEntity xsi:type="rmdl:Root" name="Example"/>
      <featureEntity xsi:type="rmdl:Element" name="Feature4"/>
      <featureEntity xsi:type="rmdl:Element" name="Feature7"/>
      <featureEntity xsi:type="rmdl:Element" name="Feature1">
        <testCase ID="1" requirements="//@feature_model.0/@product_variant.0/@featureEntity.3/@requirements.0"/>
        <testCase ID="2" requirements="//@feature_model.0/@product_variant.0/@featureEntity.3/@requirements.1"/>
        <requirements xsi:type="rmdl:Functional" name="FunctionalReq1" ID="1" review="//@feature_model.0/@product_variant.0/@featureEntity.3/@review.0" testCase="//@feature_model.0/@product_variant.0/@featureEntity.3/@testCase.0" traceTo="//@feature_model.0/@product_variant.0/@featureEntity.3/@designElement.0"/>
        <requirements xsi:type="rmdl:Functional" name="FunctionalReq2" ID="2" review="//@feature_model.0/@product_variant.0/@featureEntity.3/@review.1" testCase="//@feature_model.0/@product_variant.0/@featureEntity.3/@testCase.1"/>
        <requirements xsi:type="rmdl:Functional" name="FunctionalReq3" ID="3"/>
        <review reviewer="Reviewer1" requirements="//@feature_model.0/@product_variant.0/@featureEntity.3/@requirements.0"/>
        <review reviewer="Reviewer2" requirements="//@feature_model.0/@product_variant.0/@featureEntity.3/@requirements.1"/>
        <designElement name="designElement1" traceFrom="//@feature_model.0/@product_variant.0/@featureEntity.3/@requirements.0" implementationOf="//@feature_model.0/@featureEntity.3"/>
      </featureEntity>
    </product_variant>
    <product_variant name="Example Variant2">
      <featureEntity xsi:type="rmdl:Root" name="Example Variant2"/>
    </product_variant>
  </feature_model>
  <requirement_canvas name="Example"/>
</rmdl:RMDL_Project>
