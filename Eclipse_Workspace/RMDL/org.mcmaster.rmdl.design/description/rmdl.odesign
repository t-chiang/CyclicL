<?xml version="1.0" encoding="UTF-8"?>
<description:Group xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:description="http://www.eclipse.org/sirius/description/1.1.0" xmlns:description_1="http://www.eclipse.org/sirius/diagram/description/1.1.0" xmlns:description_2="http://www.eclipse.org/sirius/table/description/1.1.0" xmlns:properties="http://www.eclipse.org/sirius/properties/1.0.0" xmlns:properties-xtext="http://altran.com/general/integration/xtextsirius/model/properties/1.0" xmlns:style="http://www.eclipse.org/sirius/diagram/description/style/1.1.0" xmlns:tool="http://www.eclipse.org/sirius/diagram/description/tool/1.1.0" xmlns:tool_1="http://www.eclipse.org/sirius/description/tool/1.1.0" name="rmdl" version="12.0.0.2017041100">
  <ownedViewpoints name="Requirement Modelling Viewpoint" modelFileExtension="rmdl">
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="Requirements Canvas" titleExpression="aql: 'Requirement Canvas ' + self.name" domainClass="rmdl::Requirement_Canvas" enablePopupBars="true">
      <metamodel href="../../org.mcmaster.requirements_modelling.rmdl/model/rmdl.ecore#/"/>
      <defaultLayer name="Default">
        <toolSections name="Custom tools">
          <ownedTools xsi:type="tool:DirectEditLabel" name="editEntityNames">
            <mask mask="{0}"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:0"/>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool_1:PopupMenu" name="Impact Analysis">
            <menuItemDescription xsi:type="tool_1:GroupMenu" name="Impact Analysis">
              <itemDescriptions xsi:type="tool_1:ExternalJavaAction" name="Requirements Change Impact Analysis" forceRefresh="true" id="ReqChangeImpactAnalysis"/>
              <itemDescriptions xsi:type="tool_1:ExternalJavaAction" name="Requirements Clear Impact Analysis" forceRefresh="true" id="ReqClearImpactAnalysis"/>
            </menuItemDescription>
          </ownedTools>
          <ownedTools xsi:type="tool_1:GroupMenu" name="Sync Requirement With Container" locationURI="menu">
            <itemDescriptions xsi:type="tool_1:OperationAction" name="Sync With Container" precondition="aql:self.eContainer().oclIsTypeOf(rmdl::RequirementContainer)">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="review" valueExpression="aql:self.eContainer().review"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="testcase" valueExpression="aql:self.eContainer().testcase"/>
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="traceto" valueExpression="aql:self.eContainer().traceto"/>
                </firstModelOperations>
              </initialOperation>
            </itemDescriptions>
          </ownedTools>
          <ownedTools xsi:type="tool_1:GroupMenu" name="Real req sync" locationURI="menu">
            <itemDescriptions xsi:type="tool_1:OperationAction" name="OMG I HOPE" precondition="aql:self.oclIsKindOf(rmdl::RequirementContainer)">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                  <subModelOperations xsi:type="properties:DialogModelOperation" titleExpression="aql:self.eContents(n|n.name.startsWith('Con')).name">
                    <buttons labelExpression="aql:self.review.reviewer" closeDialogOnClick="true" rollbackChangesOnClose="true">
                      <initialOperation/>
                    </buttons>
                    <buttons labelExpression="OK" default="true" closeDialogOnClick="true">
                      <initialOperation/>
                    </buttons>
                    <page name="Default Page" labelExpression="Page" semanticCandidateExpression="var:self" groups="//@ownedViewpoints[name='Requirement%20Modelling%20Viewpoint']/@ownedRepresentations[name='Requirements%20Canvas']/@defaultLayer/@toolSections.0/@ownedTools[name='Real%20req%20sync']/@itemDescriptions.0/@initialOperation/@firstModelOperations/@subModelOperations.0/@groups.0"/>
                    <groups name="Default Group" labelExpression="Group" semanticCandidateExpression="var:self"/>
                  </subModelOperations>
                </firstModelOperations>
              </initialOperation>
            </itemDescriptions>
          </ownedTools>
          <ownedTools xsi:type="tool_1:GroupMenu" name="Change Impact Analysis" locationURI="menu">
            <itemDescriptions xsi:type="tool_1:OperationAction" name="Requirement Change Impact Analysis" precondition="aql: self.oclIsKindOf(rmdl::RequirementType)">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                  <subModelOperations xsi:type="tool_1:For"/>
                  <subModelOperations xsi:type="tool:CreateView" mapping="//@ownedViewpoints[name='Requirement%20Modelling%20Viewpoint']/@ownedRepresentations[name='Requirements%20Canvas']/@additionalLayers[name='Model%20Layer']/@nodeMappings[name='Functional%20Requirement']"/>
                </firstModelOperations>
              </initialOperation>
            </itemDescriptions>
          </ownedTools>
          <ownedTools xsi:type="tool:ContainerDropDescription" dragSource="BOTH">
            <oldContainer name="oldSemanticContainer"/>
            <newContainer name="newSemanticContainer"/>
            <element name="element"/>
            <newViewContainer name="newContainerView"/>
            <initialOperation/>
          </ownedTools>
        </toolSections>
      </defaultLayer>
      <additionalLayers name="Model Layer" activeByDefault="true">
        <nodeMappings name="Functional Requirement" labelDirectEdit="//@ownedViewpoints[name='Requirement%20Modelling%20Viewpoint']/@ownedRepresentations[name='Requirements%20Canvas']/@defaultLayer/@toolSections.0/@ownedTools[name='editEntityNames']" semanticCandidatesExpression="feature:requirements" domainClass="rmdl::Functional">
          <style xsi:type="style:SquareDescription" labelSize="12" showIcon="false" labelPosition="node" resizeKind="NSEW" width="17" height="10">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <color xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='light_gray']"/>
          </style>
        </nodeMappings>
        <nodeMappings name="Qualitative Requirement" labelDirectEdit="//@ownedViewpoints[name='Requirement%20Modelling%20Viewpoint']/@ownedRepresentations[name='Requirements%20Canvas']/@defaultLayer/@toolSections.0/@ownedTools[name='editEntityNames']" semanticCandidatesExpression="feature:requirements" domainClass="rmdl::Qualitative">
          <style xsi:type="style:SquareDescription" labelSize="12" showIcon="false" labelPosition="node" resizeKind="NSEW" width="17" height="10">
