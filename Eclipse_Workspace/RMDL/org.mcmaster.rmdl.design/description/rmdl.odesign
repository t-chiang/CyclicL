  <extensions xsi:type="properties:ViewExtensionDescription" name="Requirements Properties View">
    <categories>
      <pages name="Rgh Gui" labelExpression="Requirement Specification" domainClass="rmdl::RequirementType" semanticCandidateExpression="var:self" groups="//@extensions.0/@categories.0/@groups.0"/>
      <pages name="Properties" labelExpression="Properties" semanticCandidateExpression="var:self">
        <extends href="platform:/plugin/org.eclipse.sirius.properties.defaultrules/model/properties.odesign#//@extensions.0/@categories.0/@pages.0"/>
      </pages>
      <groups name="Requirements_DSL" labelExpression="Specification" domainClass="rmdl::RequirementType" semanticCandidateExpression="var:self">
        <controls xsi:type="properties:ContainerDescription" name="DSL_Container">
          <controls xsi:type="properties-xtext:XtextMultiLineValueDescription" name="Requirement Specification" lineCount="15" valueExpression="feature:specification" injectorId="org.mcmaster.rmdl.xtextsirius.RghLangInjectorId" cancelOnValidationError="true">
