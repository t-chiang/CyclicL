    <ownedRepresentations xsi:type="description_2:EditionTableDescription" name="Feature-Feature Traceability" titleExpression="aql: 'Feature-Feature Traceability ' + self.name" domainClass="rmdl::Feature_Model" initialHeaderColumnWidth="150">
      <ownedLineMappings name="Feature" domainClass="rmdl::Root" semanticCandidatesExpression="aql:self.featureEntity" headerLabelExpression="aql:self.name"/>
