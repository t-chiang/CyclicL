        </nodeMappings>
        <edgeMappings name="Mandatory" sourceMapping="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Product%20Variant']/@additionalLayers[name='Model%20Layer']/@nodeMappings[name='Product%20Feature'] //@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Product%20Variant']/@additionalLayers[name='Model%20Layer']/@nodeMappings[name='Product%20Root']" targetMapping="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Product%20Variant']/@additionalLayers[name='Model%20Layer']/@nodeMappings[name='Product%20Feature']" targetFinderExpression="feature:mandatory">
          <style sourceArrow="FillDiamond" sizeComputationExpression="2">
            <strokeColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            <centerLabelStyleDescription labelSize="12">
              <labelColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
            </centerLabelStyleDescription>
          </style>
        </edgeMappings>
      </additionalLayers>
    </ownedRepresentations>
    <ownedRepresentations xsi:type="description_1:DiagramDescription" name="Feature Model" titleExpression="aql: 'Feature Model ' + self.name" initialisation="true" pasteDescriptions="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@additionalLayers[name='Unused%20stuff']/@toolSections.0/@ownedTools[name='Paste%20Feature%20with%20Requirements']" domainClass="rmdl::Feature_Model" enablePopupBars="true">
      <metamodel href="../../org.mcmaster.requirements_modelling.rmdl/model/rmdl.ecore#/"/>
      <defaultLayer name="Default">
        <toolSections name="Custom tools">
          <ownedTools xsi:type="tool:DirectEditLabel" name="editEntityNames">
            <mask mask="{0}"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="var:0"/>
            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:DiagramCreationDescription" name="Create Requirement Canvas" forceRefresh="true" diagramDescription="//@ownedViewpoints[name='Requirement%20Modelling%20Viewpoint']/@ownedRepresentations[name='Requirements%20Canvas']">
            <initialOperation>
              <firstModelOperations xsi:type="tool:CreateView" mapping="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@additionalLayers[name='Model%20Layer']/@nodeMappings[name='Feature']" containerViewExpression="feature:featureentity"/>
            </initialOperation>
            <containerViewVariable name="containerView"/>
            <representationNameVariable name="diagramName"/>
          </ownedTools>
          <ownedTools xsi:type="tool_1:GroupMenu" name="Compose Features to Product" locationURI="menu">
            <itemDescriptions xsi:type="tool_1:OperationAction" name="Compose Features" precondition="aql:self.oclIsTypeOf(rmdl::Root)">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                  <subModelOperations xsi:type="properties:DialogModelOperation" titleExpression="Select features to compose">
                    <buttons labelExpression="Cancel" closeDialogOnClick="true" rollbackChangesOnClose="true">
                      <initialOperation/>
                    </buttons>
                    <buttons labelExpression="OK" default="true" closeDialogOnClick="true">
                      <initialOperation>
                        <firstModelOperations xsi:type="tool:CreateView" mapping="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@additionalLayers[name='Model%20Layer']/@nodeMappings[name='Root']" containerViewExpression="feature:feature_model"/>
                      </initialOperation>
                    </buttons>
                    <page name="Product Features page" labelExpression="Product Features" domainClass="rmdl::Root" semanticCandidateExpression="var:self" groups="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@defaultLayer/@toolSections.0/@ownedTools[name='Compose%20Features%20to%20Product']/@itemDescriptions.0/@initialOperation/@firstModelOperations/@subModelOperations.0/@groups.0"/>
                    <groups name="Product Features group" labelExpression="Group" domainClass="rmdl::Root" semanticCandidateExpression="var:self">
                      <controls xsi:type="properties:ListDescription" name="Other feature composition" labelExpression="Select features for composition" valueExpression="aql: self.eContainer().eAllContents(rmdl::Element)" displayExpression="aql: value.name">
                        <actions labelExpression="Make new product">
                          <initialOperation>
                            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self"/>
                          </initialOperation>
                        </actions>
                      </controls>
                    </groups>
                  </subModelOperations>
                </firstModelOperations>
              </initialOperation>
            </itemDescriptions>
          </ownedTools>
          <ownedTools xsi:type="tool_1:GroupMenu" name="Create Product Variant" locationURI="menu">
            <itemDescriptions xsi:type="tool_1:OperationAction" name="Create Product Variant" precondition="aql:self.oclIsTypeOf(rmdl::Feature_Model)">
              <view name="views"/>
              <initialOperation>
                <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                  <subModelOperations xsi:type="tool_1:CreateInstance" typeName="rmdl::Product_Variant" referenceName="product_variant">
                    <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:self.eContainer().name + ' Variant' + self.eContainer().product_variant->filter(rmdl::Product_Variant)->size()"/>
                  </subModelOperations>
                </firstModelOperations>
              </initialOperation>
            </itemDescriptions>
          </ownedTools>
          <ownedTools xsi:type="tool:DiagramCreationDescription" name="Create Product Variant Model" forceRefresh="true" diagramDescription="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Product%20Variant']">
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="rmdl::Root" referenceName="featureentity">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql: self.eContainer().name"/>
                </subModelOperations>
                <subModelOperations xsi:type="properties:DialogModelOperation" titleExpression="Select Elements for Product Variant">
                  <buttons labelExpression="Cancel" closeDialogOnClick="true" rollbackChangesOnClose="true">
                    <initialOperation/>
                  </buttons>
                  <buttons labelExpression="OK" default="true" closeDialogOnClick="true">
                    <initialOperation/>
                  </buttons>
                  <page name="Default Page" labelExpression="Page" domainClass="rmdl::Feature_Model" semanticCandidateExpression="var:self" groups="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@defaultLayer/@toolSections.0/@ownedTools[name='Create%20Product%20Variant%20Model']/@initialOperation/@firstModelOperations/@subModelOperations.1/@groups.0"/>
                  <groups name="Default Group" labelExpression="List of Features" semanticCandidateExpression="var:self">
                    <controls xsi:type="properties:ListDescription" name="List of Features" labelExpression="List of Features" valueExpression="aql: self.eContainer().eContents(rmdl::Element)" displayExpression="aql: value.name">
                      <onClickOperation>
                        <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                          <subModelOperations xsi:type="tool_1:CreateInstance" typeName="rmdl::Element" referenceName="featureentity">
                            <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:'Feature'+ self.eContainer().eContents(rmdl::Element)->size()"/>
                          </subModelOperations>
                        </firstModelOperations>
                      </onClickOperation>
                    </controls>
                    <controls xsi:type="properties:ListDescription" name="Added Features to Product Variant" labelExpression="Added Features to Product Variant" valueExpression="aql: self.eContents(rmdl::Element)" displayExpression="aql: value.name">
                      <onClickOperation>
                        <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                          <subModelOperations xsi:type="tool_1:DeleteView"/>
                        </firstModelOperations>
                      </onClickOperation>
                    </controls>
                  </groups>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
            <containerViewVariable name="containerView"/>
            <representationNameVariable name="diagramName"/>
          </ownedTools>
          <ownedTools xsi:type="tool_1:PasteDescription" name="Paste Feature with Requirements" forceRefresh="true">
            <container name="container"/>
            <containerView name="containerView"/>
            <copiedView name="copiedView"/>
            <copiedElement name="copiedElement"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
                <subModelOperations xsi:type="tool_1:For" expression="copiedElement">
                  <subModelOperations xsi:type="tool_1:CreateInstance" typeName="rmdl::Element" referenceName="featureentity">
                    <subModelOperations xsi:type="tool_1:SetValue" featureName="productof" valueExpression="aql:copiedElement"/>
                    <subModelOperations xsi:type="properties:DialogModelOperation" titleExpression="New Dialog">
                      <buttons labelExpression="Cancel" closeDialogOnClick="true" rollbackChangesOnClose="true">
                        <initialOperation/>
                      </buttons>
                      <buttons labelExpression="OK" default="true" closeDialogOnClick="true">
                        <initialOperation/>
                      </buttons>
                      <page name="Default Page" labelExpression="Page" semanticCandidateExpression="var:self" groups="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@defaultLayer/@toolSections.0/@ownedTools[name='Paste%20Feature%20with%20Requirements']/@initialOperation/@firstModelOperations/@subModelOperations.0/@subModelOperations.0/@subModelOperations.1/@groups.0"/>
                      <groups name="Default Group" labelExpression="Group" semanticCandidateExpression="var:self"/>
                    </subModelOperations>
                    <subModelOperations xsi:type="tool_1:If" conditionExpression="aql:copiedElement.composes->notEmpty()">
                      <subModelOperations xsi:type="tool_1:For" expression="aql: container.eContents()">
                        <subModelOperations xsi:type="tool_1:If" conditionExpression="aql: i.name == copiedElement.composes.name">
                          <subModelOperations xsi:type="tool_1:SetValue" featureName="composes" valueExpression="aql: i"/>
                        </subModelOperations>
                      </subModelOperations>
                      <subModelOperations xsi:type="properties:DialogModelOperation" titleExpression="New Dialog">
                        <buttons labelExpression="Cancel" closeDialogOnClick="true" rollbackChangesOnClose="true">
                          <initialOperation/>
                        </buttons>
                        <buttons labelExpression="OK" default="true" closeDialogOnClick="true">
                          <initialOperation/>
                        </buttons>
                        <page name="Default Page" labelExpression="Page" semanticCandidateExpression="var:self" groups="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@defaultLayer/@toolSections.0/@ownedTools[name='Paste%20Feature%20with%20Requirements']/@initialOperation/@firstModelOperations/@subModelOperations.0/@subModelOperations.0/@subModelOperations.2/@subModelOperations.1/@groups.0"/>
                        <groups name="Default Group" labelExpression="Group" semanticCandidateExpression="var:self"/>
                      </subModelOperations>
                    </subModelOperations>
                    <subModelOperations xsi:type="tool_1:SetValue" featureName="composes" valueExpression="aql: container.eContents(rmdl::Root)"/>
                  </subModelOperations>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
        </toolSections>
      </defaultLayer>
      <additionalLayers name="Model Layer" activeByDefault="true">
        <nodeMappings name="Root" labelDirectEdit="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@defaultLayer/@toolSections.0/@ownedTools[name='editEntityNames']" semanticCandidatesExpression="feature:featureEntity" domainClass="rmdl::Root">
          <style xsi:type="style:SquareDescription" borderSizeComputationExpression="3" labelSize="12" labelPosition="node" resizeKind="NSEW" width="16" height="8">
            <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
