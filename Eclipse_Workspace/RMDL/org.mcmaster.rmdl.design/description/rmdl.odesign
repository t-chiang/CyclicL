                    <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:copiedElement.name"/>
                  </subModelOperations>
                  <subModelOperations xsi:type="tool:CreateEdgeView" mapping="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@additionalLayers[name='Model%20Layer']/@edgeMappings[name='Mandatory']" sourceExpression="aql: copiedElement.">
