        <nodeMappings name="Feature" detailDescriptions="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@defaultLayer/@toolSections.0/@ownedTools[name='Create%20Requirement%20Canvas']" labelDirectEdit="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@defaultLayer/@toolSections.0/@ownedTools[name='editEntityNames']" semanticCandidatesExpression="feature:featureEntity" domainClass="rmdl::Element">
