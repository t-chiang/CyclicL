        </edgeMappings>
        <toolSections name="Elements">
          <ownedTools xsi:type="tool:NodeCreationDescription" name="Root" precondition="aql: (self.featureEntity->filter(rmdl::Root)->size())==0" nodeMappings="//@ownedViewpoints[name='Product%20Variant%20Viewpoint']/@ownedRepresentations[name='Feature%20Model']/@additionalLayers[name='Model%20Layer']/@nodeMappings[name='Root']">
