      <ownedColumnMappings name="Feature" headerLabelExpression="Feature" initialWidth="150" featureName="requirement_canvas" labelExpression="aql: if (self.eContainer().oclIsTypeOf(rmdl::RequirementContainer)) then (self.requirementContainer.requirement_canvas.name) else (self.requirement_canvas.name) endif  "/>
      <ownedColumnMappings name="Design Element" headerLabelExpression="Design Element" initialWidth="150" canEdit="true" featureName="traceTo" labelExpression="aql: if (self.eContainer().oclIsTypeOf(rmdl::RequirementContainer)) then (self.requirementContainer.traceTo.name) else (self.traceTo.name) endif"/>
