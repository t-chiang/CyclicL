      <ownedColumnMappings name="Test Case Passed" label="Test Case Passed" headerLabelExpression="Test Case Passed" initialWidth="150" featureName="testCase" labelExpression="aql: if (self.eContainer().oclIsTypeOf(rmdl::RequirementContainer)) then (self.requirementContainer.testCase.hasPassed) else (self.testCase.hasPassed) endif"/>
