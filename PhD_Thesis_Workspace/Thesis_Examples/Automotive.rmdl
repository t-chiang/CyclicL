<?xml version="1.0" encoding="UTF-8"?>
<rmdl:RMDL_Project xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:rmdl="http://www.example.org/rmdl">
  <feature_model name="Adaptive Cruise Control">
    <feature_model_root name="Adaptive Cruise Control" mandatory="//@feature_model.0/@feature_model_element.0 //@feature_model.0/@feature_model_element.1 //@feature_model.0/@feature_model_element.2 //@feature_model.0/@feature_model_element.3"/>
    <feature_model_element name="Steering wheel" composes="//@feature_model.0/@feature_model_root" optional="//@feature_model.0/@feature_model_element.4"/>
    <feature_model_element name="On/Off trigger" composes="//@feature_model.0/@feature_model_root"/>
    <feature_model_element name="Manual override" composes="//@feature_model.0/@feature_model_root"/>
    <feature_model_element name="Automatic braking" composes="//@feature_model.0/@feature_model_root" alternative="//@feature_model.0/@feature_model_element.5 //@feature_model.0/@feature_model_element.6"/>
    <feature_model_element name="Wheel heating" optionOf="//@feature_model.0/@feature_model_element.0"/>
    <feature_model_element name="Lidar and sonar sensors" alternativeOf="//@feature_model.0/@feature_model_element.3"/>
    <feature_model_element name="Radar and camera sensors" alternativeOf="//@feature_model.0/@feature_model_element.3"/>
  </feature_model>
</rmdl:RMDL_Project>
